{
  "name": "@solana-programs/quarry-registry",
  "version": "0.8.1",
  "description": "TypeScript client for the Quarry Registry program, which tracks the quarries of a rewarder",
  "type": "module",
  "sideEffects": false,
  "author": "Ian Macalinao <me@ianm.com>",
  "homepage": "https://coda.ianm.com",
  "license": "Apache-2.0",
  "keywords": [
    "coda",
    "solana",
    "client",
    "esm",
    "typescript",
    "quarry",
    "registry",
    "ian-macalinao"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "src/"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rm -fr dist/ node_modules/ tsconfig.tsbuildinfo"
  },
  "peerDependencies": {
    "@solana/kit": "^6.10.0 || ^7.0.0 || ^8.0.0",
    "@solana/program-client-core": "^6.10.0 || ^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@macalinao/tsconfig": "catalog:",
    "@solana/kit": "catalog:",
    "@solana/program-client-core": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macalinao/coda.git",
    "directory": "clients/quarry-registry"
  }
}
