{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_AUTH_TOKEN"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "./dist/**",
        "./.next/**"
      ],
      "env": [
        "NODE_ENV"
      ]
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "test:run": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "codegen": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "graph": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    }
  }
}
