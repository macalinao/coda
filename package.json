{
  "name": "@macalinao/coda-monorepo",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "author": "Ian Macalinao <me@ianm.com>",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "clients/*"
    ],
    "catalog": {
      "typescript": "^7.0.2",
      "@macalinao/tsconfig": "^4.0.0",
      "@solana/kit": "^8.3.0",
      "@solana/program-client-core": "^8.3.0",
      "@types/bun": "~1.4.2",
      "codama": "^1.11.0",
      "@codama/nodes": "^1.11.0",
      "@codama/nodes-from-anchor": "^1.5.6",
      "@codama/renderers-core": "^1.4.1",
      "@codama/visitors-core": "^1.11.0",
      "ws": "^8.21.3",
      "tsdown": "^0.23.0"
    }
  },
  "scripts": {
    "build": "turbo build",
    "build:ci": "turbo build --filter='./{packages,clients}/**'",
    "build:packages": "turbo build --filter='./packages/**'",
    "build:watch": "turbo watch build",
    "build:watch:packages": "turbo watch build --filter='./packages/**'",
    "lint": "oxlint --disable-nested-config && oxfmt --check",
    "lint:fix": "oxlint --disable-nested-config --fix && oxfmt",
    "clean": "turbo run clean && rm -rf node_modules/ docs/",
    "test": "CI=true turbo run test",
    "watch": "turbo watch build",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "ci:version": "changeset version && bun update",
    "ci:publish": "./scripts/ci-publish.sh",
    "prepare": "husky",
    "codegen": "turbo run codegen",
    "typecheck": "tsc -p tsconfig.configs.json",
    "size": "size-limit",
    "docs:dev": "turbo dev --filter=coda-docs",
    "docs:build": "turbo build --filter=coda-docs",
    "format": "oxfmt"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@size-limit/preset-small-lib": "13.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "size-limit": "13.1.1",
    "tsdown": "^0.23.0",
    "turbo": "^2.10.13",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "wrangler": "^4.131.2"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24",
    "bun": ">=1.4.2"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,tsx}": "oxfmt --write"
  },
  "overrides": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@codama/errors": "^1.10.2",
    "@codama/nodes": "^1.10.2",
    "@codama/renderers-core": "^1.4.0",
    "@codama/visitors-core": "^1.10.2",
    "js-yaml": "^4.3.2",
    "brace-expansion": "^5.0.9",
    "mdast-util-to-hast": "^13.2.1",
    "baseline-browser-mapping": "^2.11.23"
  }
}
